{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "build",
  "agents": {
    "build": {
      "description": "Desarrollo principal de K_engine: runtime C++17, editor y empaquetador.",
      "mode": "primary",
      "model": "deepseek/deepseek-flash"
    },
    "plan": {
      "description": "Planificación y razonamiento para el MVP de K_engine.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro"
    },
    "plan-light": {
      "description": "Planificación ligera para tareas acotadas del MVP de K_engine.",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "system": "Planifica cambios para K_engine sin modificar el repositorio. Inspecciona el código y la documentación relevantes, desglosa la tarea en fases verificables y señala decisiones, riesgos y criterios de aceptación. No edites archivos del proyecto; si necesitas conservar un plan, usa únicamente el archivo de planificación de OpenCode.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "~/.opencode/plan/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "~/.opencode/plan/*",
          "effect": "allow"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*.md",
      "effect": "ask"
    },
    {
